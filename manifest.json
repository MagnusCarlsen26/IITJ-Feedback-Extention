{
  "manifest_version": 3,
  "name": "IITJ Feedback",
  "version": "1.0",
  "description": "Automatically fills out feedback forms on IITJ ERP.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["*://erp.iitj.ac.in/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "favicon.png",   
      "48": "favicon.png",
      "128": "favicon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://erp.iitj.ac.in/*"],
      "js": [
        "namespace.js",
        "utils/sentiment/getSentimentValue.js",
        "utils/api/fetchSubjects.js",
        "utils/api/submitFeedback.js",
        "utils/subjects/determineSubjectType.js",
        "utils/subjects/processSubjects.js",
        "main.js"
      ]
    }
  ]
}
